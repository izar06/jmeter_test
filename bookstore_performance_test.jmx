        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /Account/v1/GenerateToken" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">10000</intProp>
