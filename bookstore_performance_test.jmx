            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract ISBN acak dari daftar buku" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">isbn_rand</stringProp>
